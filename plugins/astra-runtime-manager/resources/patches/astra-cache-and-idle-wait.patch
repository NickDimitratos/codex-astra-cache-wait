+#[test_case(Continuation::Resume; "resume")]
+#[test_case(Continuation::Fork; "fork")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn reasoning_effort_override_continuation_keeps_original_request_effort(
+    continuation: Continuation,
+) -> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let mut mocks = Vec::new();
+    for id in ["initial", "changed", "resumed"] {
+        mocks.push(
+            responses::mount_sse_once(&server, responses::sse(vec![responses::ev_completed(id)]))
+                .await,
+        );
+    }
+    let mut builder = override_builder();
+    let test = builder.build_with_auto_env(&server).await?;
+    test.submit_text_turn("initial message").await?;
+    submit_thread_settings(
+        &test.codex,
+        ThreadSettingsOverrides {
+            effort: Some(Some(ReasoningEffort::High)),
+            ..Default::default()
+        },
+    )
+    .await?;
+    test.submit_text_turn("higher effort").await?;
+    let continued = match continuation {
+        Continuation::Resume => {
+            override_builder()
+                .with_config(|config| config.model_reasoning_effort = Some(ReasoningEffort::High))
+                .restart(&server, &test)
+                .await?
+                .codex
+        }
+        Continuation::Fork => {
+            let mut config = test.config.clone();
+            config.model_reasoning_effort = Some(ReasoningEffort::High);
+            test.thread_manager
+                .fork_thread(
+                    codex_core::ForkSnapshot::TruncateBeforeNthUserMessage(2),
+                    config,
+                    test.codex.rollout_path().expect("rollout path"),
+                    /*thread_source*/ None,
+                    /*parent_trace*/ None,
+                )
+                .await?
+                .thread
+        }
+    };
+    continued
