@@ -0,0 +1,36 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn event_driven_wait_wakes_on_user_steering() {
+    let (sender, mut receiver) = tokio::sync::watch::channel(InputQueueActivity::Mailbox);
+    let wait = wait_for_activity(&mut receiver, None, WaitDeadline::UntilActivity);
+    tokio::pin!(wait);
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), &mut wait)
+            .await
+            .is_err()
+    );
+    sender.send_replace(InputQueueActivity::Steer);
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(1), wait)
+            .await
+            .unwrap(),
+        WaitOutcome::Steered
+    );
+}
+
+#[tokio::test]
+async fn event_driven_wait_does_not_hang_when_activity_channel_closes() {
+    let (sender, mut receiver) = tokio::sync::watch::channel(InputQueueActivity::Mailbox);
+    drop(sender);
+    assert_eq!(
+        tokio::time::timeout(
+            Duration::from_secs(1),
+            wait_for_activity(&mut receiver, None, WaitDeadline::UntilActivity)
+        )
+        .await
+        .unwrap(),
+        WaitOutcome::TimedOut
+    );
+}
