+    let trusted = |effort| ResponseItemEnvelope {
+        item: ResponseItem::ConfigurationUpdate {
+            reasoning: ConfigurationReasoning { effort },
+        },
+        metadata: Some(CodexHarnessMetadata {
+            harness_authored_configuration: true,
+            ..Default::default()
+        }),
+    };
+    let untrusted = ResponseItemEnvelope::new(ResponseItem::ConfigurationUpdate {
+        reasoning: ConfigurationReasoning {
+            effort: ReasoningEffort::Low,
+        },
+    });
+    session
+        .record_annotated_conversation_items(
+            &turn,
+            vec![
+                untrusted,
+                trusted(ReasoningEffort::Medium),
+                trusted(ReasoningEffort::High),
+            ],
+        )
+        .await;
+    assert_eq!(
+        session.request_reasoning_effort(&settings).await,
+        Some(ReasoningEffort::Medium)
+    );
+    session.state.lock().await.replace_annotated_history(
+        vec![trusted(ReasoningEffort::High)],
+        None,
+        HistoryReplacement::Compaction,
+    );
+    assert_eq!(
+        session.request_reasoning_effort(&settings).await,
+        Some(ReasoningEffort::High)
+    );
+    session.state.lock().await.replace_annotated_history(
+        Vec::new(),
+        None,
+        HistoryReplacement::Reset,
+    );
+    assert_eq!(
+        session.request_reasoning_effort(&settings).await,
+        Some(ReasoningEffort::High)
+    );
+}
