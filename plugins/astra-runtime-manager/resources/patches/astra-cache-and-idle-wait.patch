+++ b/codex-rs/core/tests/suite/code_mode/event_wait.rs
@@ -0,0 +1,52 @@
+use super::*;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn code_mode_event_wait_does_not_return_empty_timer_yields() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let code = "// @exec: {\"yield_time_ms\": 1}\nawait new Promise(resolve => setTimeout(resolve, 12000)); text('ready');";
+    let (test, started) = run_code_mode_turn_with_config(&server, "start work", code, |config| {
+        config.features.enable(Feature::EventDrivenWait).unwrap();
+    })
+    .await?;
+    let first_request = started.single_request();
+    let first_items = custom_tool_output_items(&first_request, "call-1");
+    assert!(
+        text_item(&first_items, /*index*/ 0).starts_with("Script running with cell ID "),
+        "initial cell output: {first_items:?}"
+    );
+    let cell_id = extract_running_cell_id(text_item(&first_items, /*index*/ 0));
+    responses::mount_sse_once(
+        &server,
+        sse(vec![
+            responses::ev_function_call(
+                "call-wait",
+                "wait",
+                &serde_json::json!({"cell_id": cell_id}).to_string(),
+            ),
+            ev_completed("waiting"),
+        ]),
+    )
+    .await;
+    let completed = responses::mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("done", "done"),
+            ev_completed("completed"),
+        ]),
+    )
+    .await;
+    test.submit_turn("wait for the result").await?;
+    let request = completed.single_request();
+    let items = function_tool_output_items(&request, "call-wait");
+    assert!(
+        text_item(&items, /*index*/ 0).contains("Script completed"),
+        "an empty timer yield must stay in the runtime rather than start another model request"
+    );
+    assert!(
+        items
+            .iter()
+            .any(|item| item.get("text").and_then(Value::as_str) == Some("ready"))
+    );
+    Ok(())
+}
