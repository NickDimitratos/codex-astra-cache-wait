@@ -0,0 +1,78 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn event_driven_wait_stays_pending_until_mailbox_activity() {
+    let (session, mut turn) = make_session_and_context().await;
+    let mut config = (*turn.config).clone();
+    config
+        .features
+        .enable(Feature::EventDrivenWait)
+        .expect("enable event waits");
+    config.multi_agent_v2.default_wait_timeout_ms = 1;
+    set_turn_config(&mut turn, config);
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let handler = WaitAgentHandlerV2::default();
+    let wait = handler.handle(invocation(
+        session.clone(),
+        turn,
+        "wait_agent",
+        function_payload(json!({})),
+    ));
+    tokio::pin!(wait);
+    assert!(
+        timeout(Duration::from_millis(20), &mut wait).await.is_err(),
+        "an idle default timeout must not return control to the model"
+    );
+    session
+        .input_queue
+        .enqueue_mailbox_communication(
+            InterAgentCommunication::new(
+                AgentPath::root(),
+                AgentPath::root(),
+                Vec::new(),
+                "worker completed".to_string(),
+                /*trigger_turn*/ false,
+            ),
+            Default::default(),
+        )
+        .await;
+    let output = timeout(Duration::from_secs(1), &mut wait)
+        .await
+        .expect("mailbox should wake wait")
+        .expect("wait succeeds");
+    let (content, _) = expect_text_output(output);
+    let result: crate::tools::handlers::multi_agents_v2::wait::WaitAgentResult =
+        serde_json::from_str(&content).unwrap();
+    assert!(!result.timed_out);
+    assert_eq!(result.message, "Wait completed.");
+}
+
+#[tokio::test]
+async fn event_driven_wait_preserves_explicit_timeouts() {
+    let (session, mut turn) = make_session_and_context().await;
+    let mut config = (*turn.config).clone();
+    config
+        .features
+        .enable(Feature::EventDrivenWait)
+        .expect("enable event waits");
+    config.multi_agent_v2.min_wait_timeout_ms = 1;
+    set_turn_config(&mut turn, config);
+    let output = timeout(
+        Duration::from_secs(1),
+        WaitAgentHandlerV2::default().handle(invocation(
+            Arc::new(session),
+            Arc::new(turn),
+            "wait_agent",
+            function_payload(json!({"timeout_ms": 1})),
+        )),
+    )
+    .await
+    .expect("explicit deadline should still expire")
+    .expect("wait succeeds");
+    let (content, _) = expect_text_output(output);
+    let result: crate::tools::handlers::multi_agents_v2::wait::WaitAgentResult =
+        serde_json::from_str(&content).unwrap();
+    assert!(result.timed_out);
+}
